<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Privacy Policy - Bible Album</title>
<meta name="description" content="Bible Album collects no data.">
<link rel="canonical" href="https://biblealbum.org/privacy">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans&display=swap" rel="stylesheet">
<style>
    :root {
      color-scheme: light;
      --sky: #c8eafb;
      --panel: #ddf2fc;
      --sky-deep: #bce3f7;
      --cream: #fff7e9;
      --ink: #173447;
      --link: #075274;
      --blue: #35b9ed;
      --green: #8dca47;
      --gold: #edbf3e;
      --pink: #ed88a7;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--sky);
      color: var(--ink);
      font-family: "Josefin Sans", "Trebuchet MS", Arial, sans-serif;
      font-size: 18px;
      line-height: 1.65;
    }
    main, footer { width: min(1100px, calc(100% - 32px)); margin-inline: auto; }
    main { padding-top: 24px; }
    h1, h2 {
      font-family: "Cinzel Decorative", Georgia, "Times New Roman", serif;
      font-weight: 400;
      line-height: 1.3;
      text-wrap: balance;
    }
    h1 { font-size: clamp(2.15rem, 6vw, 3.9rem); margin: 14px 0 22px; }
    h2 { font-size: clamp(1.55rem, 3.5vw, 2.2rem); margin: 0 0 22px; }
    h3 { font-size: 1.25rem; line-height: 1.4; margin: 0 0 10px; }
    p { margin: 0 0 20px; }
    a { color: var(--link); text-underline-offset: 4px; text-decoration-thickness: 1.5px; }
    a:hover { text-decoration-thickness: 3px; }
    a:focus-visible { outline: 3px solid #8d2451; outline-offset: 5px; border-radius: 5px; }
    .panel {
      background: var(--cream);
      border-radius: 26px;
      padding: clamp(24px, 5vw, 52px);
      margin-bottom: 28px;
      border-top: 5px solid var(--blue);
    }
    .hero { display: grid; grid-template-columns: 1.35fr 1fr; column-gap: 48px; row-gap: 0; align-items: center; }
    .hero-copy, .hero-download { background: transparent; border-radius: 0; padding: 0; }
    .hero figure { align-self: center; }
    @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } }
    .eyebrow {
      display: inline-block;
      border-bottom: 3px solid var(--green);
      font-size: .95rem;
      letter-spacing: .03em;
      padding-bottom: 5px;
    }
    .promise { font-size: 1.25rem; }
    .text-wrap {
      background: #ffffff;
      padding: 19px 22px;
      border-radius: 16px;
      color: var(--ink);
    }
    .small { font-size: 1rem; }
    figure { margin: 0; text-align: center; }
    img {
      display: block;
      max-width: 100%;
      height: auto;
      margin-inline: auto;
      border-radius: 20px;
      box-shadow: 0 10px 26px rgba(22, 85, 118, .15);
    }
    .app-art { width: min(100%, 260px); }
    .jacket { width: min(100%, 350px); }
    figcaption { margin-top: 15px; font-size: 1rem; }
    .badges { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin: 22px 0; }
    .badges a { display: inline-flex; align-items: center; min-height: 52px; border-radius: 10px; }
    .store-badge { height: 52px; width: auto; }
    .badges svg { height: 52px; width: auto; max-width: 100%; border-radius: 10px; display: block; }
    .hero-download { grid-column: 1; }
    .hero-download .badges { justify-content: center; }
    .hero-download > p { text-align: center; }
    .devotional { border-color: var(--gold); }
    .devotional p:last-child, .panel > p:last-child { margin-bottom: 0; }
    .widgets { border-color: var(--green); }
    .steps { padding: 0; margin: 24px 0; list-style: none; counter-reset: steps; display: grid; gap: 16px; }
    .steps li {
      counter-increment: steps;
      background: #ffffff;
      border-radius: 18px;
      padding: 22px;
    }
    .steps li::before {
      content: counter(steps);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--green);
      color: #19320b;
      font-weight: bold;
      margin-bottom: 15px;
    }
    .steps p { margin-bottom: 0; }
    .book { border-color: var(--pink); }
    .book-layout { display: grid; gap: 30px; align-items: center; }
    .award { border-left: 4px solid var(--gold); padding-left: 16px; }
    .faq { border-color: var(--gold); }
    .question + .question { border-top: 2px solid var(--sky-deep); padding-top: 24px; margin-top: 26px; }
    .question p { margin-bottom: 0; }
    .privacy { font-size: 1rem; padding: 24px; border-color: var(--blue); }
    footer { padding: 16px 0 40px; }
    .language-nav { background: var(--cream); border-radius: 26px; padding: clamp(24px, 4vw, 40px); }
    .languages { display: grid; grid-template-columns: 1fr; list-style: none; padding: 0; margin: 0; gap: 5px 24px; }
    .languages a { display: block; padding: 8px 0; overflow-wrap: anywhere; font-size: 1rem; }
    .languages [aria-current="page"] { font-weight: bold; }
    @media (min-width: 520px) {
      .languages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (min-width: 800px) {
      main { padding-top: 40px; }
      .hero { grid-template-columns: 1.35fr 1fr; column-gap: 48px; row-gap: 0; }
      .hero figure { grid-column: 2; grid-row: 1 / 3; }
      .hero-download .badges { justify-content: flex-start; }
      .hero-download > p { text-align: left; }
      .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .book-layout { grid-template-columns: .85fr 1.15fr; gap: 48px; }
      .languages { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
</head>
